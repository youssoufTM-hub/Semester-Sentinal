# Optional alternative to parser_config.json: copy to backend/.env (git-ignored).
# Values here override parser_config.json.
# Never commit real keys.

PARSER_PROVIDER=gemini            # gemini | openai
# PARSER_MODEL=gemini-3.5-flash   # optional override
# PARSER_FALLBACK_MODELS=gemini-3.5-flash-lite

GEMINI_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1   # OpenRouter / Groq / Ollama etc.
